# Copy to .env and fill in your values, or run: bash scripts/generate-secrets.sh

# Required
JWT_SECRET=            # openssl rand -hex 32
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
ADMIN_NAME=Admin

# Web Push notifications (required for push notifications)
# Generate with: bash scripts/generate-secrets.sh
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Optional — AI care suggestions. Select exactly one provider.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Phase 3+ — Groq (primary) + Cerebras (fallback) for chat/scan.
# Verified 2026-09-14 from official docs (console.groq.com/docs, inference-docs.cerebras.ai).
# Groq vision+chat: meta-llama/llama-4-scout-17b-16e-instruct (native multimodal, 5 images, JSON mode, tool use).
# Groq alt vision: qwen/qwen3.6-27b. Base URL: https://api.groq.com/openai/v1
# Cerebras vision: gemma-4-31b (Public Preview, base64 data-URI only, no external URLs) or qwen-3.8-27b (text+image).
# Cerebras chat: qwen-3.8-27b (set reasoning_effort=none). Base URL: https://api.cerebras.ai/v1
# Keys are never committed — set via env or user Settings in UI.
GROQ_API_KEY=
GROQ_CHAT_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CEREBRAS_API_KEY=
CEREBRAS_CHAT_MODEL=qwen-3.8-27b
CEREBRAS_VISION_MODEL=gemma-4-31b

# Phase 2 — default UI language: en | hi | gu
DEFAULT_LANGUAGE=en

# Optional — species search (https://perenual.com/api/auth/signup)
PERENUAL_API_KEY=

# Dev only — comma-separated hostnames the Vite dev server accepts
# ALLOWED_HOSTS=sprout.example.com
